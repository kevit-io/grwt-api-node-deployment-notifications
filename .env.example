NODE_ENV=local
PORT=3000

LOG_LEVEL=all
ALERT_LOG_LEVEL=error

# Microsoft Teams Bot Configuration
BOT_APP_ID=your-bot-app-id-here
BOT_APP_PASSWORD=your-bot-app-password-here

# Teams Conversation Details (Optional - auto-captured on bot installation)
TEAMS_SERVICE_URL=https://smba.trafficmanager.net/amer/
TEAMS_CONVERSATION_ID=
TEAMS_TENANT_ID=your-tenant-id-here

# Email Configuration (AWS SES SMTP)
SMTP_HOST=email-smtp.your-region.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL=no-reply@your-domain.com

# GitHub Actions OIDC Authentication
# The audience URL that GitHub OIDC tokens must be issued for (your API URL)
GH_OIDC_AUDIENCE=https://your-deployment-bot-api.com
# Whitelist entire GitHub orgs - any repo in these orgs can call the API
# Comma-separated: your-org,another-org
ALLOWED_GITHUB_ORGS=kevit-io,botprosolutions-com,Canada-Core,JAMSHI-Technologies-Inc
# Optional: further restrict to specific repos within the org (leave empty to allow all repos in org)
ALLOWED_GITHUB_REPOS=
# Optional: Comma-separated list of allowed GitHub environments
ALLOWED_GITHUB_ENVIRONMENTS=production,staging,development
# Optional: Static API key for backward compatibility or fallback
DEPLOY_API_KEY=
